{
  "info": {
    "name": "Listings API",
    "description": "Коллекция запросов для лабораторной работы №1 — платформа продажи/обмена подержанными вещами",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "GET /listings — список всех объявлений",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/listings", "host": ["{{baseUrl}}"], "path": ["listings"] }
      }
    },
    {
      "name": "GET /listings?category=Электроника — фильтр",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/listings?category=Электроника",
          "host": ["{{baseUrl}}"],
          "path": ["listings"],
          "query": [{ "key": "category", "value": "Электроника" }]
        }
      }
    },
    {
      "name": "GET /listings/:id — существующий (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/listings/1", "host": ["{{baseUrl}}"], "path": ["listings", "1"] }
      }
    },
    {
      "name": "GET /listings/:id — не найден (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/listings/999", "host": ["{{baseUrl}}"], "path": ["listings", "999"] }
      }
    },
    {
      "name": "POST /listings — создать (201)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Наушники Sony WH-1000XM4\",\n  \"description\": \"Комплект полный, коробка сохранена\",\n  \"category\": \"Электроника\",\n  \"price\": 12000,\n  \"condition\": \"used\",\n  \"sellerId\": 2\n}"
        },
        "url": { "raw": "{{baseUrl}}/listings", "host": ["{{baseUrl}}"], "path": ["listings"] }
      }
    },
    {
      "name": "POST /listings — невалидные данные (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"Электроника\",\n  \"price\": 1000\n}"
        },
        "url": { "raw": "{{baseUrl}}/listings", "host": ["{{baseUrl}}"], "path": ["listings"] }
      }
    },
    {
      "name": "PUT /listings/:id — обновить (200)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Зимняя куртка The North Face, размер L\",\n  \"description\": \"Цена снижена, торг уместен\",\n  \"category\": \"Одежда\",\n  \"price\": 2800,\n  \"condition\": \"used\",\n  \"status\": \"reserved\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/listings/2", "host": ["{{baseUrl}}"], "path": ["listings", "2"] }
      }
    },
    {
      "name": "PUT /listings/:id — не найден (404)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"test\",\n  \"category\": \"test\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/listings/999", "host": ["{{baseUrl}}"], "path": ["listings", "999"] }
      }
    },
    {
      "name": "DELETE /listings/:id — удалить (200)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/listings/3", "host": ["{{baseUrl}}"], "path": ["listings", "3"] }
      }
    },
    {
      "name": "DELETE /listings/:id — повторное удаление (404)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/listings/3", "host": ["{{baseUrl}}"], "path": ["listings", "3"] }
      }
    }
  ]
}
